# -----------------------------------------------------------------------------
# File: synth_sid_player.tcl
# Purpose: out-of-context Vivado synthesis check of sid_player with the
#   patched reDIP-SID gateware (third_party/redip-sid/ik64, deviations D1..D3) and
#   the inferred fpga/hdl/redip/muladd.sv (D4): proves the sources are accepted
#   (readmemh tables, elaboration-time $tanh/$pow), reports utilization and the
#   worst setup slack at a 10 ns cpu_clk. No implementation.
#   scripts/ik64_common_synth_check.tcl is not used: it has no clock constraint, so no slack.
# Usage: scripts via scripts/ik64_vivado.ps1
#   -Tcl fpga/synth_sid_player.tcl -Log build/synth/sid_player.log
#   [-TclArgs <part>]   (default xc7a200tsbg484-1)
# Exit codes: 0 pass, 10 synthesis error or critical warning.
# Revision: 11-09-2026
#   * 11-09-2026: initial version.
#   * 11-09-2026: reads third_party/redip-sid/ik64 instead of private patched copies.
#   * 11-10-2026: ik64_axil_slave replaces the RTLNet source; launcher is scripts/ik64_vivado.ps1.
# -----------------------------------------------------------------------------
set repo [file normalize [file join [file dirname [info script]] ".."]]
set part [expr {[llength $argv] > 0 ? [lindex $argv 0] : "xc7a200tsbg484-1"}]
# The reDIP-SID sources come from third_party/redip-sid/ik64, generated by
# tools/redip_patch.py (python -I tools/setup_third_party.py runs it); deviations
# D1..D3 are listed in fpga/DEVIATIONS.md. The .hex tables and .svh includes sit
# in the same directory (readmemh and `include resolve through -include_dirs).
set sid [file join $repo third_party redip-sid ik64]
foreach f {sid_pkg.sv sid_control.sv sid_waveform.sv sid_envelope.sv sid_pot.sv sid_dac.sv sid_voice.sv sid_filter.sv sid_api.sv} {
  if {![file exists [file join $sid $f]]} {
    puts "synth_sid_player: FAIL $sid/$f missing; run python -I tools/setup_third_party.py"; exit 10
  }
}
set files [list \
  [file join $repo fpga hdl common ik64_common_pkg.sv] \
  [file join $repo fpga hdl common ik64_axil_slave.sv] \
  [file join $repo fpga hdl c64_pkg.sv] \
  [file join $sid sid_pkg.sv] \
  [file join $sid sid_control.sv] \
  [file join $sid sid_waveform.sv] \
  [file join $sid sid_envelope.sv] \
  [file join $sid sid_pot.sv] \
  [file join $sid sid_dac.sv] \
  [file join $sid sid_voice.sv] \
  [file join $sid sid_filter.sv] \
  [file join $sid sid_api.sv] \
  [file join $repo fpga hdl redip muladd.sv] \
  [file join $repo fpga hdl sid_player.sv]]
foreach f $files { read_verilog -sv $f }
if {[catch {synth_design -top sid_player -part $part -mode out_of_context -include_dirs [list $sid]} err]} {
  puts "synth_sid_player: FAIL synth_design: $err"; exit 10
}
create_clock -name cpu_clk -period 10.000 [get_ports cpu_clk]
report_utilization -file [file join [pwd] sid_player_utilization.rpt]
report_timing_summary -file [file join [pwd] sid_player_timing.rpt] -max_paths 5
set wns [get_property SLACK [get_timing_paths -max_paths 1 -nworst 1 -setup]]
puts "synth_sid_player: WNS $wns ns at 10 ns"
set crit [get_msg_config -count -severity {CRITICAL WARNING}]
puts "synth_sid_player: critical warnings $crit"
if {$crit > 0} { puts "synth_sid_player: FAIL critical warnings"; exit 10 }
puts "synth_sid_player: PASS sid_player"
exit 0
